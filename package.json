{
  "name": "isha-tour",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').copyFileSync('LICENSE', 'dist/LICENSE')\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locales.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:locales && npm run build"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.160.0",
    "eslint": "^10.15.0",
    "globals": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16"
  }
}
